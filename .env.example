# Server only: never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
HOST=127.0.0.1
CHAT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
# Public frontend URL. Leave blank in development to use the Vite proxy.
# In production set this to your deployed HTTPS backend URL ending in /api/chat.
VITE_CHAT_API_URL=
